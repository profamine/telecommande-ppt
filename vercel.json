{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"Site statique : pas de dépendances à installer\"",
  "buildCommand": "",
  "outputDirectory": "website",
  "rewrites": [
    {
      "source": "/telecharger/windows",
      "destination": "https://github.com/profamine/telecommande-ppt/releases/download/v1.0.0/Telecommande-PPT-Setup.exe"
    },
    {
      "source": "/telecharger/android",
      "destination": "https://github.com/profamine/telecommande-ppt/releases/download/v1.0.0/Telecommande-PPT.apk"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
